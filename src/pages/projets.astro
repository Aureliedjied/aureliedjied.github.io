---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const categories = (await getCollection('categories')).sort(
  (a, b) => a.data.order - b.data.order
);

const allLabs = await getCollection('labs');

const categoriesWithLabs = categories.map(cat => ({
  ...cat,
  labs: allLabs
    .filter(lab => lab.data.category === cat.id)
    .sort((a, b) => a.data.order - b.data.order),
}));
---

<Layout title="Mes projets">
  <div class="py-12 md:py-20">

    <!-- En-tête -->
    <header class="mb-16">
      <p class="text-xs font-black uppercase tracking-widest mb-3" style="color: var(--text-muted);">
        Labs & explorations
      </p>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight leading-tight mb-6" style="color: var(--text-title);">
        Ce que je construis,<br/>
        <span class="text-purple-500">casse, et reconstruis.</span>
      </h1>
      <p class="text-sm md:text-base leading-relaxed border-l-2 border-purple-500/40 pl-4 max-w-xl" style="color: var(--text-muted);">
        Des labs documentés au fil des découvertes — infra on-premise, DevOps, cybersécurité.
        Chaque projet est un terrain d'expérimentation réel, pas un tuto suivi.
      </p>
    </header>

    <!-- Catégories -->
    <div class="space-y-24">
      {categoriesWithLabs.map((cat, i) => (
        <section>

          <!-- Bloc titre catégorie — très visible sur mobile -->
          <div class="flex items-center gap-4 mb-2">
            <div class="flex items-center gap-3 flex-1">
              <!-- Numéro de catégorie -->
              <span class="text-[10px] font-black tabular-nums opacity-30" style="color: var(--text-main);">
                0{i + 1}
              </span>
              <!-- Titre -->
              <h2 class="text-xl md:text-2xl font-black tracking-tight" style="color: var(--text-title);">
                {cat.data.title}
              </h2>
            </div>
            <!-- Compteur discret -->
            <span class="shrink-0 text-[10px] font-bold px-2 py-1 rounded-full border"
              style="background-color: var(--card-bg); border-color: var(--card-border); color: var(--text-muted);">
              {cat.labs.filter(l => l.data.status === 'active').length > 0
                ? `${cat.labs.filter(l => l.data.status === 'active').length} actif`
                : 'À venir'}
            </span>
          </div>

          <!-- Description catégorie -->
          <p class="text-sm leading-relaxed mb-8 max-w-lg pl-7" style="color: var(--text-muted);">
            {cat.data.description}
          </p>

          <!-- Grille de labs -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
            {cat.labs.map(lab => (
              lab.data.status === 'active' ? (

                <!-- Carte active -->
                <a
                  href={`/projets/${lab.id}`}
                  class="group relative flex flex-col gap-5 p-6 md:p-8 rounded-[2rem] border transition-all duration-500 hover:-translate-y-2"
                  style={`background-color: var(--card-bg); border-color: var(--card-border); --lab-color: ${lab.data.color};`}
                >
                  <!-- Icône + statut -->
                  <div class="flex items-start justify-between">
                    <div
                      class="w-12 h-12 rounded-2xl flex items-center justify-center text-2xl border transition-all group-hover:scale-110"
                      style={`background-color: ${lab.data.color}22; border-color: ${lab.data.color}33; color: ${lab.data.color};`}
                    >
                      {lab.data.icon === 'server'   && <i class="ri-server-line"></i>}
                      {lab.data.icon === 'devops'   && <i class="ri-loop-right-line"></i>}
                      {lab.data.icon === 'shield'   && <i class="ri-shield-keyhole-line"></i>}
                      {lab.data.icon === 'terminal' && <i class="ri-terminal-box-fill"></i>}
                      {lab.data.icon === 'cloud'    && <i class="ri-cloud-line"></i>}
                      {lab.data.icon === 'network'  && <i class="ri-router-line"></i>}
                    </div>
                    <span class="text-[9px] font-black uppercase tracking-widest px-2 py-1 rounded-full"
                      style="background-color: rgba(16,185,129,0.1); color: rgb(16,185,129);">
                      En cours
                    </span>
                  </div>

                  <!-- Titre + desc -->
                  <div class="flex-1 space-y-2">
                    <h3
                      class="text-lg md:text-xl font-black tracking-tight group-hover:text-[var(--lab-color)] transition-colors"
                      style="color: var(--text-title);"
                    >
                      {lab.data.title}
                    </h3>
                    <p class="text-sm leading-relaxed opacity-70" style="color: var(--text-main);">
                      {lab.data.description}
                    </p>
                  </div>

                  <!-- Tags -->
                  <div class="flex flex-wrap gap-2">
                    {lab.data.tags.slice(0, 4).map(tag => (
                      <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded border border-white/5 bg-white/5 opacity-50">
                        #{tag}
                      </span>
                    ))}
                  </div>

                  <!-- Footer -->
                  <div class="flex items-center justify-between pt-4 border-t" style="border-color: var(--card-border);">
                    <span class="text-[10px] opacity-40" style="color: var(--text-main);">
                      {lab.data.seriesCount > 0 && `${lab.data.seriesCount} séries · ${lab.data.articlesCount} articles`}
                    </span>
                    <span
                      class="text-xs font-black uppercase tracking-widest transition-transform group-hover:translate-x-2 inline-block"
                      style={`color: ${lab.data.color};`}
                    >
                      Explorer →
                    </span>
                  </div>
                </a>

              ) : (

                <!-- Carte à venir -->
                <div
                  class="relative flex flex-col gap-5 p-6 md:p-8 rounded-[2rem] border border-dashed opacity-40 cursor-default select-none"
                  style="background-color: var(--card-bg); border-color: var(--card-border);"
                >
                  <div class="flex items-start justify-between">
                    <div
                      class="w-12 h-12 rounded-2xl flex items-center justify-center text-2xl border"
                      style={`background-color: ${lab.data.color}11; border-color: ${lab.data.color}22; color: ${lab.data.color};`}
                    >
                      {lab.data.icon === 'server'   && <i class="ri-server-line"></i>}
                      {lab.data.icon === 'devops'   && <i class="ri-loop-right-line"></i>}
                      {lab.data.icon === 'shield'   && <i class="ri-shield-keyhole-line"></i>}
                      {lab.data.icon === 'terminal' && <i class="ri-terminal-box-fill"></i>}
                      {lab.data.icon === 'cloud'    && <i class="ri-cloud-line"></i>}
                      {lab.data.icon === 'network'  && <i class="ri-router-line"></i>}
                    </div>
                    <span class="text-[9px] font-bold uppercase tracking-widest px-2 py-1 rounded-full border border-dashed"
                      style="color: var(--text-muted); border-color: var(--card-border);">
                      À venir
                    </span>
                  </div>

                  <div class="flex-1 space-y-2">
                    <h3 class="text-lg md:text-xl font-black tracking-tight" style="color: var(--text-title);">
                      {lab.data.title}
                    </h3>
                    <p class="text-sm leading-relaxed opacity-70" style="color: var(--text-main);">
                      {lab.data.description}
                    </p>
                  </div>

                  <div class="flex flex-wrap gap-2">
                    {lab.data.tags.slice(0, 4).map(tag => (
                      <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded border border-white/5 bg-white/5 opacity-30">
                        #{tag}
                      </span>
                    ))}
                  </div>

                  <div class="pt-4 border-t" style="border-color: var(--card-border);">
                    <span class="text-[10px] opacity-40" style="color: var(--text-muted);">
                      En cours de préparation…
                    </span>
                  </div>
                </div>
              )
            ))}
          </div>

        </section>
      ))}
    </div>

    <!-- Badges — discret, en bas -->
    <div class="mt-24 pt-10 border-t" style="border-color: var(--card-border);">
      <div class="flex items-center gap-4 p-6 rounded-[2rem] border border-dashed opacity-40"
        style="background-color: var(--card-bg); border-color: var(--card-border);">
        <div class="w-10 h-10 rounded-2xl flex items-center justify-center text-lg border border-white/10 bg-white/5 shrink-0">
          <i class="ri-award-line"></i>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-black tracking-tight" style="color: var(--text-title);">Badges & certifications</p>
          <p class="text-xs opacity-50 mt-0.5" style="color: var(--text-main);">
            Microsoft Learn · ANSSI · TryHackMe — disponible prochainement.
          </p>
        </div>
        <span class="shrink-0 text-[9px] font-bold uppercase tracking-widest px-2 py-1 rounded-full border border-dashed"
          style="color: var(--text-muted); border-color: var(--card-border);">
          Bientôt
        </span>
      </div>
    </div>

  </div>
</Layout>