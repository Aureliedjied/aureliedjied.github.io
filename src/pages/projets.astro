---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const categories = (await getCollection('categories')).sort(
  (a, b) => a.data.order - b.data.order
);

const allLabs = await getCollection('labs');

const categoriesWithLabs = categories.map(cat => ({
  ...cat,
  labs: allLabs
    .filter(lab => lab.data.category === cat.id)
    .sort((a, b) => a.data.order - b.data.order),
}));
---

<Layout title="Mes projets">
  <div class="max-w-4xl mx-auto py-16 px-6">

    <header class="mb-14">
      <h1 class="text-4xl font-bold tracking-tighter mb-3" style="color: var(--text-title);">
        Mes projets
      </h1>
      <p class="text-base opacity-60 max-w-xl leading-relaxed" style="color: var(--text-main);">
        Labs, explorations et apprentissages — de l'infra on-premise au DevOps,
        documentés au fil des découvertes.
      </p>
    </header>

    <div class="space-y-14">
      {categoriesWithLabs.map((cat, i) => (
        <section>

          <div class="flex items-baseline gap-3 mb-2">
            <h2 class="text-sm font-semibold uppercase tracking-widest" style="color: var(--text-title);">
              {cat.data.title}
            </h2>
            <span class="text-xs opacity-40" style="color: var(--text-main);">
              {cat.labs.filter(l => l.data.status === 'active').length > 0
                ? `${cat.labs.filter(l => l.data.status === 'active').length} actif`
                : 'À venir'}
              {cat.labs.filter(l => l.data.status === 'coming-soon').length > 0
                && ` · ${cat.labs.filter(l => l.data.status === 'coming-soon').length} en préparation`}
            </span>
          </div>

          <p class="text-sm opacity-50 mb-6 max-w-lg leading-relaxed" style="color: var(--text-main);">
            {cat.data.description}
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {cat.labs.map(lab => (
              lab.data.status === 'active' ? (
                <a
                  href={`/projets/${lab.id}`}
                  class="group relative flex flex-col gap-4 p-6 rounded-2xl border transition-all duration-300 hover:-translate-y-1"
                  style={`background-color: var(--card-bg); border-color: var(--card-border); --lab-color: ${lab.data.color};`}
                >
                  <div
                    class="w-10 h-10 rounded-xl flex items-center justify-center text-lg border transition-transform group-hover:scale-110"
                    style={`background-color: ${lab.data.color}15; border-color: ${lab.data.color}25; color: ${lab.data.color};`}
                  >
                    {lab.data.icon === 'server'   && <i class="ri-server-line"></i>}
                    {lab.data.icon === 'devops'   && <i class="ri-loop-right-line"></i>}
                    {lab.data.icon === 'shield'   && <i class="ri-shield-keyhole-line"></i>}
                    {lab.data.icon === 'terminal' && <i class="ri-terminal-box-fill"></i>}
                    {lab.data.icon === 'cloud'    && <i class="ri-cloud-line"></i>}
                    {lab.data.icon === 'network'  && <i class="ri-router-line"></i>}
                  </div>

                  <div class="flex-1">
                    <h3
                      class="text-base font-semibold mb-1 group-hover:text-[var(--lab-color)] transition-colors"
                      style="color: var(--text-title);"
                    >
                      {lab.data.title}
                    </h3>
                    <p class="text-sm opacity-60 leading-relaxed" style="color: var(--text-main);">
                      {lab.data.description}
                    </p>
                  </div>

                  <div class="flex flex-wrap gap-1.5">
                    {lab.data.tags.slice(0, 4).map(tag => (
                      <span class="text-[10px] font-medium px-2 py-0.5 rounded-md border border-white/5 bg-white/5 opacity-50">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <div
                    class="flex items-center justify-between pt-4 border-t"
                    style="border-color: var(--card-border);"
                  >
                    <span class="text-[11px] opacity-40" style="color: var(--text-main);">
                      {lab.data.seriesCount > 0 && `${lab.data.seriesCount} séries · ${lab.data.articlesCount} articles`}
                    </span>
                    <span
                      class="text-[11px] font-bold uppercase tracking-widest transition-transform group-hover:translate-x-1 inline-block"
                      style={`color: ${lab.data.color};`}
                    >
                      Explorer →
                    </span>
                  </div>
                </a>
              ) : (
                <div
                  class="relative flex flex-col gap-4 p-6 rounded-2xl border border-dashed opacity-40 cursor-default select-none"
                  style="background-color: var(--card-bg); border-color: var(--card-border);"
                >
                  <div class="absolute top-5 right-5">
                    <span class="text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full border border-dashed opacity-60"
                      style="color: var(--text-muted); border-color: var(--card-border);">
                      À venir
                    </span>
                  </div>

                  <div
                    class="w-10 h-10 rounded-xl flex items-center justify-center text-lg border"
                    style={`background-color: ${lab.data.color}10; border-color: ${lab.data.color}20; color: ${lab.data.color};`}
                  >
                    {lab.data.icon === 'server'   && <i class="ri-server-line"></i>}
                    {lab.data.icon === 'devops'   && <i class="ri-loop-right-line"></i>}
                    {lab.data.icon === 'shield'   && <i class="ri-shield-keyhole-line"></i>}
                    {lab.data.icon === 'terminal' && <i class="ri-terminal-box-fill"></i>}
                    {lab.data.icon === 'cloud'    && <i class="ri-cloud-line"></i>}
                    {lab.data.icon === 'network'  && <i class="ri-router-line"></i>}
                  </div>

                  <div class="flex-1">
                    <h3 class="text-base font-semibold mb-1" style="color: var(--text-title);">
                      {lab.data.title}
                    </h3>
                    <p class="text-sm opacity-60 leading-relaxed" style="color: var(--text-main);">
                      {lab.data.description}
                    </p>
                  </div>

                  <div class="flex flex-wrap gap-1.5">
                    {lab.data.tags.slice(0, 4).map(tag => (
                      <span class="text-[10px] px-2 py-0.5 rounded-md border border-white/5 bg-white/5 opacity-40">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <div class="pt-4 border-t" style="border-color: var(--card-border);">
                    <span class="text-[11px] opacity-30" style="color: var(--text-muted);">
                      En cours de préparation…
                    </span>
                  </div>
                </div>
              )
            ))}
          </div>

          {i < categoriesWithLabs.length - 1 && (
            <div class="mt-14 border-t opacity-10" style="border-color: var(--card-border);"></div>
          )}

        </section>
      ))}
    </div>

    <!-- Badges — discret, toujours en bas -->
    <div class="mt-16 pt-10 border-t opacity-30" style="border-color: var(--card-border);">
      <div class="flex items-center gap-4 p-5 rounded-2xl border border-dashed"
        style="background-color: var(--card-bg); border-color: var(--card-border);">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center text-base border border-white/10 bg-white/5">
          <i class="ri-award-line opacity-50"></i>
        </div>
        <div>
          <p class="text-sm font-medium" style="color: var(--text-title);">Badges & certifications</p>
          <p class="text-xs opacity-50 mt-0.5" style="color: var(--text-main);">
            Microsoft Learn · ANSSI · TryHackMe — disponible prochainement.
          </p>
        </div>
        <span class="ml-auto text-[10px] font-bold uppercase tracking-widest opacity-40 px-2 py-0.5 rounded-full border border-dashed"
          style="color: var(--text-muted); border-color: var(--card-border);">
          Bientôt
        </span>
      </div>
    </div>

  </div>
</Layout>