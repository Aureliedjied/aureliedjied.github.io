---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allLabs = await getCollection('labs');
const activeLabs = allLabs.filter(l => l.data.status === 'active');

const techs = [
  { name: "OPNsense",       color: "#e81123", icon: "ri-shield-keyhole-fill",    desc: "Pare-feu HA / Règles de filtrage" },
  { name: "Windows Server", color: "#0078d4", icon: "ri-microsoft-fill",          desc: "AD / GPO / PKI" },
  { name: "Linux",          color: "#fdb813", icon: "ri-terminal-box-fill",       desc: "Debian / Ubuntu / Fedora" },
  { name: "VMware",         color: "#607078", icon: "ri-server-fill",             desc: "Virtualisation" },
  { name: "Zabbix",         color: "#d40000", icon: "ri-line-chart-fill",         desc: "Supervision" },
  { name: "Veeam",          color: "#00b336", icon: "ri-archive-fill",            desc: "Backup / PRA" },
  { name: "GLPI",           color: "#42546d", icon: "ri-customer-service-2-fill", desc: "ITSM" },
  { name: "Nextcloud",      color: "#0082c9", icon: "ri-cloud-fill",              desc: "Cloud privé" },
];

const env = [
  {
    category: "OS",
    items: [
      { name: "Fedora", detail: "Version 43 KDE Plasma", icon: "ri-computer-line", color: "#51a2da" },
    ]
  },
  {
    category: "Dev & édition",
    items: [
      { name: "VSCode", detail: "IDE principal", icon: "ri-code-s-slash-line", color: "#007acc" },
      { name: "zsh", detail: "Shell au quotidien", icon: "ri-terminal-line", color: "#a855f7" },
      { name: "Firefox", detail: "Navigateur", icon: "ri-firefox-line", color: "#ff7139" },
    ]
  },
  {
    category: "Virtualisation & réseau",
    items: [
      { name: "VMware", detail: "Lab principal", icon: "ri-server-line", color: "#607078" },
      { name: "Proxmox", detail: "En exploration", icon: "ri-cpu-line", color: "#e57000" },
      { name: "Docker", detail: "Conteneurisation", icon: "ri-box-3-line", color: "#2496ed" },
      { name: "nmap", detail: "Reconnaissance réseau", icon: "ri-radar-line", color: "#e81123" },
    ]
  },
  {
    category: "Organisation",
    items: [
      { name: "Notion", detail: "Notes & documentation", icon: "ri-file-text-line", color: "#a1a1aa" },
      { name: "Trello", detail: "Gestion de projets", icon: "ri-layout-column-line", color: "#0052cc" },
    ]
  },
];
---

<Layout>

  <!-- ─── HERO ──────────────────────────────────────────────────── -->
  <section class="py-12 md:py-20 grid grid-cols-1 md:grid-cols-[auto_1fr] gap-10 md:gap-14 items-center">

    <!-- Photo -->
    <div class="flex justify-center md:justify-start">
      <div class="relative">
        <div class="w-36 h-36 md:w-44 md:h-44 rounded-full overflow-hidden border-2 shadow-xl"
             style="border-color: var(--card-border);">
          <img
            src="/photo-aurelie.jpg"
            alt="Aurélie Djied"
            class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700"
          />
        </div>
        <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 flex items-center gap-1.5 px-3 py-1 rounded-full border whitespace-nowrap"
             style="background-color: var(--card-bg); border-color: var(--card-border);">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
          </span>
          <span class="text-[9px] font-black uppercase tracking-widest text-green-500">Disponible</span>
        </div>
      </div>
    </div>

    <!-- Texte -->
    <div class="space-y-6">
      <div class="space-y-1">
        <p class="text-xs font-black uppercase tracking-widest" style="color: var(--text-muted);">
          Aurélie Djied · Toulon
        </p>
        <h1 class="text-3xl md:text-5xl font-black tracking-tight leading-tight" style="color: var(--text-title);">
          Je construis des infrastructures<br/>
          <span class="text-purple-500">pour comprendre</span><br/>
          comment les sécuriser.
        </h1>
      </div>

      <p class="text-sm md:text-base leading-relaxed border-l-2 border-purple-500/40 pl-4 max-w-xl" style="color: var(--text-muted);">
        Technicienne Systèmes et réseaux, je déploie et sécurise des infrastructures Windows/Linux en lab VMware —
        haute disponibilité OPNsense, Active Directory multi-sites, PKI, VPN.
        Des architectures que je conçois, casse, et reconstruis, en suivant les recommandations de sécurité grâce à une veille constante sur les vulnérabilités et les exigeances.
      </p>

      <p class="text-sm font-mono" style="color: var(--text-muted);">
        <span class="text-purple-500">→</span> Prochain objectif : Titre Administrateur d'Infrastructures Sécurisées — Bac+3
      </p>

      <div class="flex flex-wrap gap-3">
        <a href="/projets"
           class="px-6 py-2.5 rounded-full font-black text-sm text-white transition-all hover:scale-105 active:scale-95 shadow-lg shadow-purple-500/20"
           style="background-color: #9333ea;">
          Voir mes projets
        </a>
        <a href="/contact"
           class="px-6 py-2.5 rounded-full font-black text-sm border transition-all hover:scale-105 active:scale-95 hover:border-purple-500 hover:text-purple-500"
           style="background-color: var(--card-bg); border-color: var(--card-border); color: var(--text-main);">
          Me contacter
        </a>
      </div>
    </div>
  </section>

  <!-- ─── STACK TECHNIQUE ───────────────────────────────────────── -->
  <section class="py-8 space-y-4">
    <p class="text-xs font-black uppercase tracking-widest" style="color: var(--text-muted);">Stack technique</p>
    <div class="grid grid-cols-4 sm:grid-cols-8 gap-3">
      {techs.map(tech => (
        <div
          class="group flex flex-col items-center gap-2 p-3 rounded-2xl border transition-all duration-200 hover:scale-105 cursor-default"
          style="background-color: var(--card-bg); border-color: var(--card-border);"
        >
          <div
            class="w-9 h-9 rounded-xl flex items-center justify-center transition-all duration-200 group-hover:scale-110"
            style={`background-color: ${tech.color}22;`}
          >
            <i class={`${tech.icon} text-lg`} style={`color: ${tech.color};`}></i>
          </div>
          <div class="text-center">
            <p class="text-[9px] font-black leading-tight" style="color: var(--text-title);">{tech.name}</p>
            <p class="text-[8px] opacity-0 group-hover:opacity-100 transition-opacity duration-200 mt-0.5" style="color: var(--text-muted);">{tech.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ─── ENVIRONNEMENT DE TRAVAIL ──────────────────────────────── -->
  <section class="py-12 space-y-6">
    <div class="flex items-center gap-4">
      <p class="text-xs font-black uppercase tracking-widest" style="color: var(--text-muted);">
        Environnement de travail
      </p>
      <div class="h-px flex-1 opacity-10" style="background-color: var(--text-main);"></div>
    </div>

    <p class="text-sm max-w-lg" style="color: var(--text-muted);">
      Passée de Windows 11 PRO à <span class="font-bold" style="color: var(--text-title);">Fedora 43</span> comme poste de travail personnel.
      Parce que travailler sur Linux au quotidien,
      ça change la façon dont on pense les systèmes.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {env.map(group => (
        <div class="p-5 rounded-2xl border space-y-4"
          style="background-color: var(--card-bg); border-color: var(--card-border);">
          <p class="text-[9px] font-black uppercase tracking-widest opacity-40" style="color: var(--text-main);">
            {group.category}
          </p>
          <div class="space-y-3">
            {group.items.map(item => (
              <div class="flex items-center gap-3">
                <div
                  class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0"
                  style={`background-color: ${item.color}22; color: ${item.color};`}
                >
                  <i class={`${item.icon} text-sm`}></i>
                </div>
                <div>
                  <p class="text-sm font-bold leading-tight" style="color: var(--text-title);">{item.name}</p>
                  <p class="text-[10px] opacity-50 leading-tight mt-0.5" style="color: var(--text-main);">{item.detail}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ─── APERÇU PROJETS ────────────────────────────────────────── -->
  <section class="py-12 space-y-6">
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-4 flex-1">
        <p class="text-xs font-black uppercase tracking-widest" style="color: var(--text-muted);">
          Projets en cours
        </p>
        <div class="h-px flex-1 opacity-10" style="background-color: var(--text-main);"></div>
      </div>
      <a href="/projets"
         class="text-xs font-black uppercase tracking-widest transition-colors hover:text-purple-500"
         style="color: var(--text-muted);">
        Tout voir →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {activeLabs.map(lab => (
        <a
          href={`/projets/${lab.id}`}
          class="group flex items-center gap-4 p-5 rounded-2xl border transition-all duration-300 hover:-translate-y-1"
          style={`background-color: var(--card-bg); border-color: var(--card-border); --lab-color: ${lab.data.color};`}
        >
          <div
            class="w-10 h-10 rounded-xl flex items-center justify-center text-lg shrink-0 border transition-transform group-hover:scale-110"
            style={`background-color: ${lab.data.color}22; border-color: ${lab.data.color}33; color: ${lab.data.color};`}
          >
            {lab.data.icon === 'server'   && <i class="ri-server-line"></i>}
            {lab.data.icon === 'devops'   && <i class="ri-loop-right-line"></i>}
            {lab.data.icon === 'shield'   && <i class="ri-shield-keyhole-line"></i>}
            {lab.data.icon === 'terminal' && <i class="ri-terminal-box-fill"></i>}
            {lab.data.icon === 'cloud'    && <i class="ri-cloud-line"></i>}
            {lab.data.icon === 'network'  && <i class="ri-router-line"></i>}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-black leading-tight group-hover:text-[var(--lab-color)] transition-colors truncate"
               style="color: var(--text-title);">
              {lab.data.title}
            </p>
            <p class="text-[10px] opacity-50 mt-0.5" style="color: var(--text-main);">
              {lab.data.seriesCount > 0 ? `${lab.data.seriesCount} séries · ${lab.data.articlesCount} articles` : 'En cours'}
            </p>
          </div>
          <span class="text-xs opacity-0 group-hover:opacity-100 transition-all group-hover:translate-x-1 shrink-0"
                style={`color: ${lab.data.color};`}>→</span>
        </a>
      ))}

      <!-- Carte "suite" vers /projets -->
      <a
        href="/projets"
        class="group flex items-center gap-4 p-5 rounded-2xl border border-dashed transition-all duration-300 hover:border-purple-500/40 hover:-translate-y-1"
        style="background-color: var(--card-bg); border-color: var(--card-border);"
      >
        <div class="w-10 h-10 rounded-xl flex items-center justify-center text-lg shrink-0 border border-dashed border-purple-500/20 bg-purple-500/5 text-purple-500">
          <i class="ri-arrow-right-line group-hover:translate-x-1 transition-transform"></i>
        </div>
        <div>
          <p class="text-sm font-black" style="color: var(--text-title);">Voir tous les projets</p>
          <p class="text-[10px] opacity-50 mt-0.5" style="color: var(--text-main);">Labs, DevOps, Cybersécurité</p>
        </div>
      </a>
    </div>
  </section>

</Layout>