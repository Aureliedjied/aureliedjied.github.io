---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Présentation — Aurélie Djied">
  <div class="py-12 md:py-20 max-w-3xl">

    <!-- Accroche -->
    <section class="mb-16 space-y-6">
      <p class="text-xs font-black uppercase tracking-widest" style="color: var(--text-muted);">
        Aurélie Djied · Toulon
      </p>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight leading-tight" style="color: var(--text-title);">
        Reconvertie.<br/>
        <span class="text-purple-500">Autodidacte.</span><br/>
      </h1>
      <p class="text-sm md:text-base leading-relaxed border-l-2 border-purple-500/40 pl-4 max-w-xl" style="color: var(--text-muted);">
        Je viens de l'industrie et du dev web. Aujourd'hui je me forme à l'administration
        d'infrastructures et à la cybersécurité — pas parce que c'est tendance,
        parce que c'est ce qui m'accroche vraiment.
      </p>
      <div class="flex flex-wrap gap-3">
        <span class="flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-full border"
              style="background-color: var(--card-bg); border-color: var(--card-border); color: var(--text-muted);">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
          </span>
          Disponible en alternance — sept. 2026
        </span>
        <span class="flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-full border"
              style="background-color: var(--card-bg); border-color: var(--card-border); color: var(--text-muted);">
          <span class="text-blue-500">◎</span> Toulon · Marseille · DOM-TOM
        </span>
      </div>
    </section>

    <!-- Objectif -->
    <section class="mb-16">
      <p class="text-xs font-black uppercase tracking-widest mb-6" style="color: var(--text-muted);">
        Objectif
      </p>
      <div class="p-6 rounded-[2rem] border" style="background-color: var(--card-bg); border-color: var(--card-border);">
        <p class="text-lg font-black tracking-tight mb-2" style="color: var(--text-title);">
          Titre Administrateur d'Infrastructures Sécurisées
          <span class="text-purple-500"> — Bac+3</span>
        </p>
        <p class="text-sm leading-relaxed opacity-70 mb-4" style="color: var(--text-main);">
          En alternance à partir de septembre 2026. Orientation cybersécurité,
          administration systèmes Linux et architectures hybrides. Mastère Bac+5 en ligne de mire ensuite.
        </p>
        <p class="text-xs font-mono" style="color: var(--text-muted);">
          <span class="text-purple-500">→</span> École en cours de sélection — Toulon · Marseille · DOM-TOM
        </p>
      </div>
    </section>

    <!-- Parcours -->
    <section class="mb-16">
      <p class="text-xs font-black uppercase tracking-widest mb-8" style="color: var(--text-muted);">
        Parcours
      </p>

      <div class="space-y-10 border-l-2 ml-2 pl-8" style="border-color: var(--card-border);">

        <!-- TSSR -->
        <div class="relative">
          <div class="absolute -left-[37px] top-1 w-4 h-4 rounded-full bg-purple-500 border-4"
               style="border-color: var(--bg-color);"></div>
          <span class="text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded"
                style="background-color: rgba(168,85,247,0.1); color: #a855f7; border: 1px solid rgba(168,85,247,0.2);">
            2025 – 2026 · En cours
          </span>
          <h3 class="font-black text-lg mt-2" style="color: var(--text-title);">
            TSSR — Technicien Supérieur Systèmes et Réseaux
          </h3>
          <p class="text-sm italic opacity-60 mb-2" style="color: var(--text-main);">
            RNCP Bac+2 · La Plateforme, Toulon
          </p>
          <p class="text-sm leading-relaxed" style="color: var(--text-main);">
            Administration Windows Server et Linux, cybersécurité opérationnelle (OPNsense, VPN, hardening),
            supervision (Zabbix, Graylog), sauvegarde (Veeam). Le tout documenté dans un lab VMware personnel.
          </p>
        </div>

        <!-- Dev web -->
        <div class="relative opacity-80">
          <div class="absolute -left-[37px] top-1 w-4 h-4 rounded-full border-4"
               style="background-color: var(--card-border); border-color: var(--bg-color);"></div>
          <span class="text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded"
                style="background-color: rgba(59,130,246,0.1); color: #3b82f6; border: 1px solid rgba(59,130,246,0.2);">
            2023 – 2024
          </span>
          <h3 class="font-black text-lg mt-2" style="color: var(--text-title);">
            Développeuse Web et Web Mobile
          </h3>
          <p class="text-sm italic opacity-60 mb-2" style="color: var(--text-main);">
            O'Clock · PHP / Symfony / MySQL
          </p>
          <p class="text-sm leading-relaxed" style="color: var(--text-main);">
            Conception d'applications web, versioning Git, méthode Agile.
            Cette base me permet aujourd'hui d'aborder l'automatisation et le DevOps
            sans partir de zéro — Bash, Docker, IaC, je comprends la logique.
          </p>
        </div>

        <!-- Valeo -->
        <div class="relative opacity-70">
          <div class="absolute -left-[37px] top-1 w-4 h-4 rounded-full border-4"
               style="background-color: var(--card-border); border-color: var(--bg-color);"></div>
          <span class="text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded"
                style="background-color: rgba(113,113,122,0.1); color: #71717a; border: 1px solid rgba(113,113,122,0.2);">
            2022 – 2024
          </span>
          <h3 class="font-black text-lg mt-2" style="color: var(--text-title);">
            Technicienne métrologie & commande numérique
          </h3>
          <p class="text-sm italic opacity-60 mb-2" style="color: var(--text-main);">
            Valeo · Fabrication d'embrayages automobiles
          </p>
          <p class="text-sm leading-relaxed" style="color: var(--text-main);">
            Réglage au micromètre, programmation d'arrêts/marches sur robots et machines d'usinage (Tacchella),
            contrôle qualité métrologique. Avant de configurer des serveurs,
            j'apprenais déjà à lire des systèmes et à documenter des anomalies.
            La rigueur procédurale, c'est pas venu avec l'IT.
          </p>
        </div>

      </div>
    </section>

    <!-- Compétences -->
    <section class="mb-16">
      <p class="text-xs font-black uppercase tracking-widest mb-6" style="color: var(--text-muted);">
        Compétences
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

        <!-- Cœur de métier -->
        <div class="p-6 rounded-[2rem] border" style="background-color: var(--card-bg); border-color: var(--card-border);">
          <p class="text-xs font-black uppercase tracking-widest mb-4" style="color: var(--text-muted);">
            Cœur de métier
          </p>
          <div class="space-y-2">
            {[
              { label: "Windows Server", detail: "AD, GPO, PKI" },
              { label: "Linux", detail: "Red Hat · Debian" },
              { label: "Virtualisation", detail: "VMware · Hyper-V" },
              { label: "Réseaux", detail: "VLAN, TCP/IP, DNS/DHCP" },
              { label: "Cybersécurité", detail: "OPNsense, hardening, VPN, RGPD" },
              { label: "Supervision", detail: "Zabbix · Graylog" },
              { label: "Sauvegarde", detail: "Veeam · rsync · PRA/PCA" },
            ].map(skill => (
              <div class="flex items-baseline justify-between">
                <span class="text-sm font-bold" style="color: var(--text-title);">{skill.label}</span>
                <span class="text-xs opacity-50" style="color: var(--text-main);">{skill.detail}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Atouts transverses -->
        <div class="p-6 rounded-[2rem] border" style="background-color: var(--card-bg); border-color: var(--card-border);">
          <p class="text-xs font-black uppercase tracking-widest mb-4" style="color: var(--text-muted);">
            Atouts transverses
          </p>
          <div class="space-y-2 mb-6">
            {[
              { label: "Automatisation", detail: "Bash · PowerShell" },
              { label: "DevOps", detail: "Docker · Git · GitHub" },
              { label: "Dev web", detail: "PHP · Symfony · SQL" },
              { label: "Gestion de projet", detail: "Agile · Trello · Notion" },
              { label: "Anglais", detail: "Lecture documentation IT" },
            ].map(skill => (
              <div class="flex items-baseline justify-between">
                <span class="text-sm font-bold" style="color: var(--text-title);">{skill.label}</span>
                <span class="text-xs opacity-50" style="color: var(--text-main);">{skill.detail}</span>
              </div>
            ))}
          </div>
          <div class="pt-4 border-t" style="border-color: var(--card-border);">
            <p class="text-xs leading-relaxed opacity-60 italic" style="color: var(--text-main);">
              Rigueur procédurale héritée de l'industrie.
              Documentation comme réflexe, pas comme contrainte.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- Veille -->
    <section>
      <p class="text-xs font-black uppercase tracking-widest mb-6" style="color: var(--text-muted);">
        Veille & certifications
      </p>
      <div class="p-6 rounded-[2rem] border space-y-3" style="background-color: var(--card-bg); border-color: var(--card-border);">
        <div class="flex items-center gap-3">
          <span class="text-green-500 text-xs">●</span>
          <span class="text-sm" style="color: var(--text-main);">
            <span class="font-bold" style="color: var(--text-title);">ANSSI</span> — veille réglementaire et recommandations sécurité
          </span>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-green-500 text-xs">●</span>
          <span class="text-sm" style="color: var(--text-main);">
            <span class="font-bold" style="color: var(--text-title);">Microsoft Learn</span> — documentation et parcours certifiants
          </span>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-blue-500 text-xs">◎</span>
          <span class="text-sm opacity-70 italic" style="color: var(--text-main);">
            Certifications en préparation autodidacte — à venir
          </span>
        </div>
      </div>
    </section>

  </div>
</Layout>